{
    "number": 87,
    "name_arabic": "الأعلى",
    "name_english": "The Most High",
    "name_transliteration": "Al-A'la",
    "revelation_type": "meccan",
    "beginner_intro": "Al-A'la (\"The Most High\") is a Meccan surah of 19 ayahs. Arabic text: Tanzil Project (Uthmani script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 591,
            "arabic_text": "سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Praise the name of thy Lord the Most High,"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 591,
            "arabic_text": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Who createth, then disposeth;"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 591,
            "arabic_text": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Who measureth, then guideth;"
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 591,
            "arabic_text": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Who bringeth forth the pasturage,"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 591,
            "arabic_text": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then turneth it to russet stubble."
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 591,
            "arabic_text": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "We shall make thee read (O Muhammad) so that thou shalt not forget"
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 30,
            "page": 591,
            "arabic_text": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Save that which Allah willeth. Lo! He knoweth the disclosed and that which still is hidden;"
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 30,
            "page": 591,
            "arabic_text": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And We shall ease thy way unto the state of ease."
                }
            ]
        },
        {
            "number_in_surah": 9,
            "juz": 30,
            "page": 591,
            "arabic_text": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Therefor remind (men), for of use is the reminder."
                }
            ]
        },
        {
            "number_in_surah": 10,
            "juz": 30,
            "page": 591,
            "arabic_text": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He will heed who feareth,"
                }
            ]
        },
        {
            "number_in_surah": 11,
            "juz": 30,
            "page": 591,
            "arabic_text": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But the most hapless will flout it,"
                }
            ]
        },
        {
            "number_in_surah": 12,
            "juz": 30,
            "page": 591,
            "arabic_text": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He who will be flung to the great Fire"
                }
            ]
        },
        {
            "number_in_surah": 13,
            "juz": 30,
            "page": 591,
            "arabic_text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Wherein he will neither die nor live."
                }
            ]
        },
        {
            "number_in_surah": 14,
            "juz": 30,
            "page": 591,
            "arabic_text": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He is successful who groweth,"
                }
            ]
        },
        {
            "number_in_surah": 15,
            "juz": 30,
            "page": 591,
            "arabic_text": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And remembereth the name of his Lord, so prayeth,"
                }
            ]
        },
        {
            "number_in_surah": 16,
            "juz": 30,
            "page": 592,
            "arabic_text": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But ye prefer the life of the world"
                }
            ]
        },
        {
            "number_in_surah": 17,
            "juz": 30,
            "page": 592,
            "arabic_text": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Although the Hereafter is better and more lasting."
                }
            ]
        },
        {
            "number_in_surah": 18,
            "juz": 30,
            "page": 592,
            "arabic_text": "إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! This is in the former scrolls."
                }
            ]
        },
        {
            "number_in_surah": 19,
            "juz": 30,
            "page": 592,
            "arabic_text": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The Books of Abraham and Moses."
                }
            ]
        }
    ]
}
