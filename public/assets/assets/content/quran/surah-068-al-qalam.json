{
    "number": 68,
    "name_arabic": "القلم",
    "name_english": "The Pen",
    "name_transliteration": "Al-Qalam",
    "revelation_type": "meccan",
    "beginner_intro": "Al-Qalam (\"The Pen\") is a Meccan surah of 52 ayahs. Arabic text: Al-Quran Hafazan System (Uthmani Hafs script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 29,
            "page": 564,
            "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nun. By the pen and that which they write (therewith),"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 29,
            "page": 564,
            "arabic_text": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۢ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Thou art not, for thy Lord's favour unto thee, a madman."
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 29,
            "page": 564,
            "arabic_text": "وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍۢ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And lo! thine verily will be a reward unfailing."
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 29,
            "page": 564,
            "arabic_text": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And lo! thou art of a tremendous nature."
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 29,
            "page": 564,
            "arabic_text": "فَسَتُبْصِرُ وَيُبْصِرُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And thou wilt see and they will see"
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 29,
            "page": 564,
            "arabic_text": "بِأَييِّكُمُ ٱلْمَفْتُونُ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Which of you is the demented."
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 29,
            "page": 564,
            "arabic_text": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! thy Lord is Best Aware of him who strayeth from His way, and He is Best Aware of those who walk aright."
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 29,
            "page": 564,
            "arabic_text": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Therefor obey not thou the rejecters"
                }
            ]
        },
        {
            "number_in_surah": 9,
            "juz": 29,
            "page": 564,
            "arabic_text": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Who would have had thee compromise, that they may compromise."
                }
            ]
        },
        {
            "number_in_surah": 10,
            "juz": 29,
            "page": 564,
            "arabic_text": "وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Neither obey thou each feeble oath-monger,"
                }
            ]
        },
        {
            "number_in_surah": 11,
            "juz": 29,
            "page": 564,
            "arabic_text": "هَمَّازٍۢ مَّشَّآءٍۭ بِنَمِيمٍۢ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Detracter, spreader abroad of slanders,"
                }
            ]
        },
        {
            "number_in_surah": 12,
            "juz": 29,
            "page": 564,
            "arabic_text": "مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Hinderer of the good, transgressor, malefactor"
                }
            ]
        },
        {
            "number_in_surah": 13,
            "juz": 29,
            "page": 564,
            "arabic_text": "عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Greedy therewithal, intrusive."
                }
            ]
        },
        {
            "number_in_surah": 14,
            "juz": 29,
            "page": 564,
            "arabic_text": "أَن كَانَ ذَا مَالٍۢ وَبَنِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "It is because he is possessed of wealth and children"
                }
            ]
        },
        {
            "number_in_surah": 15,
            "juz": 29,
            "page": 564,
            "arabic_text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "That, when Our revelations are recited unto him, he saith: Mere fables of the men of old."
                }
            ]
        },
        {
            "number_in_surah": 16,
            "juz": 29,
            "page": 565,
            "arabic_text": "سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "We shall brand him on the nose."
                }
            ]
        },
        {
            "number_in_surah": 17,
            "juz": 29,
            "page": 565,
            "arabic_text": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! We have tried them as We tried the owners of the garden when they vowed that they would pluck its fruit next morning,"
                }
            ]
        },
        {
            "number_in_surah": 18,
            "juz": 29,
            "page": 565,
            "arabic_text": "وَلَا يَسْتَثْنُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And made no exception (for the Will of Allah);"
                }
            ]
        },
        {
            "number_in_surah": 19,
            "juz": 29,
            "page": 565,
            "arabic_text": "فَطَافَ عَلَيْهَا طَآئِفٌۭ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then a visitation from thy Lord came upon it while they slept"
                }
            ]
        },
        {
            "number_in_surah": 20,
            "juz": 29,
            "page": 565,
            "arabic_text": "فَأَصْبَحَتْ كَٱلصَّرِيمِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And in the morning it was as if plucked."
                }
            ]
        },
        {
            "number_in_surah": 21,
            "juz": 29,
            "page": 565,
            "arabic_text": "فَتَنَادَوْا۟ مُصْبِحِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And they cried out one unto another in the morning,"
                }
            ]
        },
        {
            "number_in_surah": 22,
            "juz": 29,
            "page": 565,
            "arabic_text": "أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Saying: Run unto your field if ye would pluck (the fruit)."
                }
            ]
        },
        {
            "number_in_surah": 23,
            "juz": 29,
            "page": 565,
            "arabic_text": "فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "So they went off, saying one unto another in low tones:"
                }
            ]
        },
        {
            "number_in_surah": 24,
            "juz": 29,
            "page": 565,
            "arabic_text": "أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌۭ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "No needy man shall enter it to-day against you."
                }
            ]
        },
        {
            "number_in_surah": 25,
            "juz": 29,
            "page": 565,
            "arabic_text": "وَغَدَوْا۟ عَلَىٰ حَرْدٍۢ قَٰدِرِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "They went betimes, strong in (this) purpose."
                }
            ]
        },
        {
            "number_in_surah": 26,
            "juz": 29,
            "page": 565,
            "arabic_text": "فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But when they saw it, they said: Lo! we are in error!"
                }
            ]
        },
        {
            "number_in_surah": 27,
            "juz": 29,
            "page": 565,
            "arabic_text": "بَلْ نَحْنُ مَحْرُومُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nay, but we are desolate!"
                }
            ]
        },
        {
            "number_in_surah": 28,
            "juz": 29,
            "page": 565,
            "arabic_text": "قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The best among them said: Said I not unto you: Why glorify ye not (Allah)?"
                }
            ]
        },
        {
            "number_in_surah": 29,
            "juz": 29,
            "page": 565,
            "arabic_text": "قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "They said: Glorified be our Lord! Lo! we have been wrong-doers."
                }
            ]
        },
        {
            "number_in_surah": 30,
            "juz": 29,
            "page": 565,
            "arabic_text": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَلَٰوَمُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then some of them drew near unto others, self-reproaching."
                }
            ]
        },
        {
            "number_in_surah": 31,
            "juz": 29,
            "page": 565,
            "arabic_text": "قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "They said: Alas for us! In truth we were outrageous."
                }
            ]
        },
        {
            "number_in_surah": 32,
            "juz": 29,
            "page": 565,
            "arabic_text": "عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًۭا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "It may be that our Lord will give us better than this in place thereof. Lo! we beseech our Lord."
                }
            ]
        },
        {
            "number_in_surah": 33,
            "juz": 29,
            "page": 565,
            "arabic_text": "كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Such was the punishment. And verily the punishment of the Hereafter is greater if they did but know."
                }
            ]
        },
        {
            "number_in_surah": 34,
            "juz": 29,
            "page": 565,
            "arabic_text": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! for those who keep from evil are gardens of bliss with their Lord."
                }
            ]
        },
        {
            "number_in_surah": 35,
            "juz": 29,
            "page": 565,
            "arabic_text": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Shall We then treat those who have surrendered as We treat the guilty?"
                }
            ]
        },
        {
            "number_in_surah": 36,
            "juz": 29,
            "page": 565,
            "arabic_text": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "What aileth you? How foolishly ye judge!"
                }
            ]
        },
        {
            "number_in_surah": 37,
            "juz": 29,
            "page": 565,
            "arabic_text": "أَمْ لَكُمْ كِتَٰبٌۭ فِيهِ تَدْرُسُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Or have ye a scripture wherein ye learn"
                }
            ]
        },
        {
            "number_in_surah": 38,
            "juz": 29,
            "page": 565,
            "arabic_text": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "That ye shall indeed have all that ye choose?"
                }
            ]
        },
        {
            "number_in_surah": 39,
            "juz": 29,
            "page": 565,
            "arabic_text": "أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Or have ye a covenant on oath from Us that reacheth to the Day of Judgment, that yours shall be all that ye ordain?"
                }
            ]
        },
        {
            "number_in_surah": 40,
            "juz": 29,
            "page": 565,
            "arabic_text": "سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Ask them (O Muhammad) which of them will vouch for that!"
                }
            ]
        },
        {
            "number_in_surah": 41,
            "juz": 29,
            "page": 565,
            "arabic_text": "أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Or have they other gods? Then let them bring their other gods if they are truthful"
                }
            ]
        },
        {
            "number_in_surah": 42,
            "juz": 29,
            "page": 565,
            "arabic_text": "يَوْمَ يُكْشَفُ عَن سَاقٍۢ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "On the day when it befalleth in earnest, and they are ordered to prostrate themselves but are not able,"
                }
            ]
        },
        {
            "number_in_surah": 43,
            "juz": 29,
            "page": 566,
            "arabic_text": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "With eyes downcast, abasement stupefying them. And they had been summoned to prostrate themselves while they were yet unhurt."
                }
            ]
        },
        {
            "number_in_surah": 44,
            "juz": 29,
            "page": 566,
            "arabic_text": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Leave Me (to deal) with those who give the lie to this pronouncement. We shall lead them on by steps from whence they know not."
                }
            ]
        },
        {
            "number_in_surah": 45,
            "juz": 29,
            "page": 566,
            "arabic_text": "وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Yet I bear with them, for lo! My scheme is firm."
                }
            ]
        },
        {
            "number_in_surah": 46,
            "juz": 29,
            "page": 566,
            "arabic_text": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Or dost thou (Muhammad) ask a fee from them so that they are heavily taxed?"
                }
            ]
        },
        {
            "number_in_surah": 47,
            "juz": 29,
            "page": 566,
            "arabic_text": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Or is the Unseen theirs that they can write (thereof)?"
                }
            ]
        },
        {
            "number_in_surah": 48,
            "juz": 29,
            "page": 566,
            "arabic_text": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌۭ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But wait thou for thy Lord's decree, and be not like him of the fish, who cried out in despair."
                }
            ]
        },
        {
            "number_in_surah": 49,
            "juz": 29,
            "page": 566,
