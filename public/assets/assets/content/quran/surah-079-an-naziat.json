{
    "number": 79,
    "name_arabic": "النازعات",
    "name_english": "Those who drag forth",
    "name_transliteration": "An-Nazi'at",
    "revelation_type": "meccan",
    "beginner_intro": "An-Nazi'at (\"Those who drag forth\") is a Meccan surah of 46 ayahs. Arabic text: Tanzil Project (Uthmani script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 583,
            "arabic_text": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "By those who drag forth to destruction,"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 583,
            "arabic_text": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "By the meteors rushing,"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 583,
            "arabic_text": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "By the lone stars floating,"
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 583,
            "arabic_text": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "By the angels hastening,"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 583,
            "arabic_text": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And those who govern the event,"
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 583,
            "arabic_text": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "On the day when the first trump resoundeth."
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 30,
            "page": 583,
            "arabic_text": "تَتْبَعُهَا ٱلرَّادِفَةُ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And the second followeth it,"
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 30,
            "page": 583,
            "arabic_text": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "On that day hearts beat painfully"
                }
            ]
        },
        {
            "number_in_surah": 9,
            "juz": 30,
            "page": 583,
            "arabic_text": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "While eyes are downcast"
                }
            ]
        },
        {
            "number_in_surah": 10,
            "juz": 30,
            "page": 583,
            "arabic_text": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "(Now) they are saying: Shall we really be restored to our first state"
                }
            ]
        },
        {
            "number_in_surah": 11,
            "juz": 30,
            "page": 583,
            "arabic_text": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Even after we are crumbled bones?"
                }
            ]
        },
        {
            "number_in_surah": 12,
            "juz": 30,
            "page": 583,
            "arabic_text": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "They say: Then that would be a vain proceeding."
                }
            ]
        },
        {
            "number_in_surah": 13,
            "juz": 30,
            "page": 583,
            "arabic_text": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Surely it will need but one shout,"
                }
            ]
        },
        {
            "number_in_surah": 14,
            "juz": 30,
            "page": 583,
            "arabic_text": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And lo! they will be awakened."
                }
            ]
        },
        {
            "number_in_surah": 15,
            "juz": 30,
            "page": 583,
            "arabic_text": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Hath there come unto thee the history of Moses?"
                }
            ]
        },
        {
            "number_in_surah": 16,
            "juz": 30,
            "page": 584,
            "arabic_text": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "How his Lord called him in the holy vale of Tuwa,"
                }
            ]
        },
        {
            "number_in_surah": 17,
            "juz": 30,
            "page": 584,
            "arabic_text": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "(Saying:) Go thou unto Pharaoh - Lo! he hath rebelled -"
                }
            ]
        },
        {
            "number_in_surah": 18,
            "juz": 30,
            "page": 584,
            "arabic_text": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And say (unto him): Hast thou (will) to grow (in grace)?"
                }
            ]
        },
        {
            "number_in_surah": 19,
            "juz": 30,
            "page": 584,
            "arabic_text": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then I will guide thee to thy Lord and thou shalt fear (Him)."
                }
            ]
        },
        {
            "number_in_surah": 20,
            "juz": 30,
            "page": 584,
            "arabic_text": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And he showed him the tremendous token."
                }
            ]
        },
        {
            "number_in_surah": 21,
            "juz": 30,
            "page": 584,
            "arabic_text": "فَكَذَّبَ وَعَصَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But he denied and disobeyed,"
                }
            ]
        },
        {
            "number_in_surah": 22,
            "juz": 30,
            "page": 584,
            "arabic_text": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then turned he away in haste,"
                }
            ]
        },
        {
            "number_in_surah": 23,
            "juz": 30,
            "page": 584,
            "arabic_text": "فَحَشَرَ فَنَادَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then gathered he and summoned"
                }
            ]
        },
        {
            "number_in_surah": 24,
            "juz": 30,
            "page": 584,
            "arabic_text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And proclaimed: \"I (Pharaoh) am your Lord the Highest.\""
                }
            ]
        },
        {
            "number_in_surah": 25,
            "juz": 30,
            "page": 584,
            "arabic_text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "So Allah seized him (and made him) an example for the after (life) and for the former."
                }
            ]
        },
        {
            "number_in_surah": 26,
            "juz": 30,
            "page": 584,
            "arabic_text": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! herein is indeed a lesson for him who feareth."
                }
            ]
        },
        {
            "number_in_surah": 27,
            "juz": 30,
            "page": 584,
            "arabic_text": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Are ye the harder to create, or is the heaven that He built?"
                }
            ]
        },
        {
            "number_in_surah": 28,
            "juz": 30,
            "page": 584,
            "arabic_text": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He raised the height thereof and ordered it;"
                }
            ]
        },
        {
            "number_in_surah": 29,
            "juz": 30,
            "page": 584,
            "arabic_text": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And He made dark the night thereof, and He brought forth the morn thereof."
                }
            ]
        },
        {
            "number_in_surah": 30,
            "juz": 30,
            "page": 584,
            "arabic_text": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And after that He spread the earth,"
                }
            ]
        },
        {
            "number_in_surah": 31,
            "juz": 30,
            "page": 584,
            "arabic_text": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And produced therefrom the water thereof and the pasture thereof,"
                }
            ]
        },
        {
            "number_in_surah": 32,
            "juz": 30,
            "page": 584,
            "arabic_text": "وَٱلْجِبَالَ أَرْسَىٰهَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And He made fast the hills,"
                }
            ]
        },
        {
            "number_in_surah": 33,
            "juz": 30,
            "page": 584,
            "arabic_text": "مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "A provision for you and for your cattle."
                }
            ]
        },
        {
            "number_in_surah": 34,
            "juz": 30,
            "page": 584,
            "arabic_text": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But when the great disaster cometh,"
                }
            ]
        },
        {
            "number_in_surah": 35,
            "juz": 30,
            "page": 584,
            "arabic_text": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The day when man will call to mind his (whole) endeavour,"
                }
            ]
        },
        {
            "number_in_surah": 36,
            "juz": 30,
            "page": 584,
            "arabic_text": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And hell will stand forth visible to him who seeth,"
                }
            ]
        },
        {
            "number_in_surah": 37,
            "juz": 30,
            "page": 584,
            "arabic_text": "فَأَمَّا مَن طَغَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then, as for him who rebelled"
                }
            ]
        },
        {
            "number_in_surah": 38,
            "juz": 30,
            "page": 584,
            "arabic_text": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And chose the life of the world,"
                }
            ]
        },
        {
            "number_in_surah": 39,
            "juz": 30,
            "page": 584,
            "arabic_text": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! hell will be his home."
                }
            ]
        },
        {
            "number_in_surah": 40,
            "juz": 30,
            "page": 584,
            "arabic_text": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But as for him who feared to stand before his Lord and restrained his soul from lust,"
                }
            ]
        },
        {
            "number_in_surah": 41,
            "juz": 30,
            "page": 584,
            "arabic_text": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! the Garden will be his home."
                }
            ]
        },
        {
            "number_in_surah": 42,
            "juz": 30,
            "page": 584,
            "arabic_text": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "They ask thee of the Hour: when will it come to port?"
                }
            ]
        },
        {
            "number_in_surah": 43,
            "juz": 30,
            "page": 584,
            "arabic_text": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Why (ask they)? What hast thou to tell thereof?"
                }
            ]
        },
        {
            "number_in_surah": 44,
            "juz": 30,
            "page": 584,
            "arabic_text": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Unto thy Lord belongeth (knowledge of) the term thereof."
                }
            ]
        },
        {
            "number_in_surah": 45,
            "juz": 30,
            "page": 584,
            "arabic_text": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Thou art but a warner unto him who feareth it."
                }
            ]
        },
        {
            "number_in_surah": 46,
            "juz": 30,
            "page": 584,
            "arabic_text": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "On the day when they behold it, it will be as if they had but tarried for an evening or the morn thereof."
                }
            ]
        }
    ]
}
