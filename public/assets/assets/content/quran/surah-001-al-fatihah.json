{
    "number": 1,
    "name_arabic": "الفاتحة",
    "name_english": "The Opener",
    "name_transliteration": "Al-Fatihah",
    "revelation_type": "meccan",
    "beginner_intro": "Al-Fatihah (\"The Opener\") is a Meccan surah of 7 ayahs. Arabic text: Al-Quran Hafazan System (Uthmani Hafs script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 1,
            "page": 1,
            "arabic_text": "﻿بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "In the name of Allah, the Beneficent, the Merciful."
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 1,
            "page": 1,
            "arabic_text": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Praise be to Allah, Lord of the Worlds,"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 1,
            "page": 1,
            "arabic_text": "ٱلرَّحْمَٰنِ ٱلرَّحِيمِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The Beneficent, the Merciful."
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 1,
            "page": 1,
            "arabic_text": "مَٰلِكِ يَوْمِ ٱلدِّينِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Master of the Day of Judgment,"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 1,
            "page": 1,
            "arabic_text": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Thee (alone) we worship; Thee (alone) we ask for help."
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 1,
            "page": 1,
            "arabic_text": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Show us the straight path,"
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 1,
            "page": 1,
            "arabic_text": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The path of those whom Thou hast favoured; Not the (path) of those who earn Thine anger nor of those who go astray."
                }
            ]
        }
    ]
}
