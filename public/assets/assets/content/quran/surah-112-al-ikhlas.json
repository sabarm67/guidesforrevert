    "beginner_intro": "Al-Ikhlas (\"The Sincerity\") is a Meccan surah of 4 ayahs. Arabic text: Al-Quran Hafazan System (Uthmani Hafs script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 604,
            "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Say: He is Allah, the One!"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 604,
            "arabic_text": "ٱللَّهُ ٱلصَّمَدُ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Allah, the eternally Besought of all!"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 604,
            "arabic_text": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He begetteth not nor was begotten."
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 604,
            "arabic_text": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And there is none comparable unto Him."
                }
            ]
        }
    ]
