{
    "number": 109,
    "name_arabic": "الكافرون",
    "name_english": "The Disbelievers",
    "name_transliteration": "Al-Kafirun",
    "revelation_type": "meccan",
    "beginner_intro": "Al-Kafirun (\"The Disbelievers\") is a Meccan surah of 6 ayahs. Arabic text: Tanzil Project (Uthmani script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 603,
            "arabic_text": "قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Say: O disbelievers!"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 603,
            "arabic_text": "لَآ أَعْبُدُ مَا تَعْبُدُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "I worship not that which ye worship;"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 603,
            "arabic_text": "وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nor worship ye that which I worship."
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 603,
            "arabic_text": "وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And I shall not worship that which ye worship."
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 603,
            "arabic_text": "وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nor will ye worship that which I worship."
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 603,
            "arabic_text": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Unto you your religion, and unto me my religion."
                }
            ]
        }
    ]
