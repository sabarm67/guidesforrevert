{
    "number": 83,
    "name_arabic": "المطففين",
    "name_english": "The Defrauding",
    "name_transliteration": "Al-Mutaffifin",
    "revelation_type": "meccan",
    "beginner_intro": "Al-Mutaffifin (\"The Defrauding\") is a Meccan surah of 36 ayahs. Arabic text: Al-Quran Hafazan System (Uthmani Hafs script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 587,
            "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Woe unto the defrauders:"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 587,
            "arabic_text": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Those who when they take the measure from mankind demand it full,"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 587,
            "arabic_text": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But if they measure unto them or weight for them, they cause them loss."
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 587,
            "arabic_text": "أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Do such (men) not consider that they will be raised again"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 587,
            "arabic_text": "لِيَوْمٍ عَظِيمٍۢ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Unto an Awful Day,"
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 587,
            "arabic_text": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The day when (all) mankind stand before the Lord of the Worlds?"
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 30,
            "page": 588,
            "arabic_text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nay, but the record of the vile is in Sijjin -"
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 30,
            "page": 588,
            "arabic_text": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Ah! what will convey unto thee what Sijjin is! -"
                }
            ]
        },
        {
            "number_in_surah": 9,
            "juz": 30,
            "page": 588,
            "arabic_text": "كِتَٰبٌۭ مَّرْقُومٌۭ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "A written record."
                }
            ]
        },
        {
            "number_in_surah": 10,
            "juz": 30,
            "page": 588,
            "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Woe unto the repudiators on that day!"
                }
            ]
        },
        {
            "number_in_surah": 11,
            "juz": 30,
            "page": 588,
            "arabic_text": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Those who deny the Day of Judgment"
                }
            ]
        },
        {
            "number_in_surah": 12,
            "juz": 30,
            "page": 588,
            "arabic_text": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Which none denieth save each criminal transgressor,"
                }
            ]
        },
        {
            "number_in_surah": 13,
            "juz": 30,
            "page": 588,
            "arabic_text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Who, when thou readest unto him Our revelations, saith: (Mere) fables of the men of old."
                }
            ]
        },
        {
            "number_in_surah": 14,
            "juz": 30,
            "page": 588,
            "arabic_text": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nay, but that which they have earned is rust upon their hearts."
                }
            ]
        },
        {
            "number_in_surah": 15,
            "juz": 30,
            "page": 588,
            "arabic_text": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nay, but surely on that day they will be covered from (the mercy of) their Lord."
                }
            ]
        },
        {
            "number_in_surah": 16,
            "juz": 30,
            "page": 588,
            "arabic_text": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then lo! they verily will burn in hell,"
                }
            ]
        },
        {
            "number_in_surah": 17,
            "juz": 30,
            "page": 588,
            "arabic_text": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And it will be said (unto them): This is that which ye used to deny."
                }
            ]
        },
        {
            "number_in_surah": 18,
            "juz": 30,
            "page": 588,
            "arabic_text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nay, but the record of the righteous is in 'Illiyin -"
                }
            ]
        },
        {
            "number_in_surah": 19,
            "juz": 30,
            "page": 588,
            "arabic_text": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Ah, what will convey unto thee what 'Illiyin is! -"
                }
            ]
        },
        {
            "number_in_surah": 20,
            "juz": 30,
            "page": 588,
            "arabic_text": "كِتَٰبٌۭ مَّرْقُومٌۭ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "A written record,"
                }
            ]
        },
        {
            "number_in_surah": 21,
            "juz": 30,
            "page": 588,
            "arabic_text": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Attested by those who are brought near (unto their Lord)."
                }
            ]
        },
        {
            "number_in_surah": 22,
            "juz": 30,
            "page": 588,
            "arabic_text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! the righteous verily are in delight,"
                }
            ]
        },
        {
            "number_in_surah": 23,
            "juz": 30,
            "page": 588,
            "arabic_text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "On couches, gazing,"
                }
            ]
        },
        {
            "number_in_surah": 24,
            "juz": 30,
            "page": 588,
            "arabic_text": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Thou wilt know in their faces the radiance of delight."
                }
            ]
        },
        {
            "number_in_surah": 25,
            "juz": 30,
            "page": 588,
            "arabic_text": "يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "They are given to drink of a pure wine, sealed,"
                }
            ]
        },
        {
            "number_in_surah": 26,
            "juz": 30,
            "page": 588,
            "arabic_text": "خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Whose seal is musk - for this let (all) those strive who strive for bliss -"
                }
            ]
        },
        {
            "number_in_surah": 27,
            "juz": 30,
            "page": 588,
            "arabic_text": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And mixed with water of Tasnim,"
                }
            ]
        },
        {
            "number_in_surah": 28,
            "juz": 30,
            "page": 588,
            "arabic_text": "عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "A spring whence those brought near (to Allah) drink."
                }
            ]
        },
        {
            "number_in_surah": 29,
            "juz": 30,
            "page": 588,
            "arabic_text": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! the guilty used to laugh at those who believed,"
                }
            ]
        },
        {
            "number_in_surah": 30,
            "juz": 30,
            "page": 588,
            "arabic_text": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And wink one to another when they passed them;"
                }
            ]
        },
        {
            "number_in_surah": 31,
            "juz": 30,
            "page": 588,
            "arabic_text": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when they returned to their own folk, they returned jesting;"
                }
            ]
        },
        {
            "number_in_surah": 32,
            "juz": 30,
            "page": 588,
            "arabic_text": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when they saw them they said: Lo! these have gone astray."
                }
            ]
        },
        {
            "number_in_surah": 33,
            "juz": 30,
            "page": 588,
            "arabic_text": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Yet they were not sent as guardians over them."
                }
            ]
        },
        {
            "number_in_surah": 34,
            "juz": 30,
            "page": 588,
            "arabic_text": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "This day it is those who believe who have the laugh of disbelievers,"
                }
            ]
        },
        {
            "number_in_surah": 35,
            "juz": 30,
            "page": 589,
            "arabic_text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "On high couches, gazing."
                }
            ]
        },
        {
            "number_in_surah": 36,
            "juz": 30,
            "page": 589,
            "arabic_text": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Are not the disbelievers paid for what they used to do?"
                }
            ]
        }
    ]
}
