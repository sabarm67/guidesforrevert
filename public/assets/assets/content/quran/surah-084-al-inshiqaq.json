{
    "number": 84,
    "name_arabic": "الإنشقاق",
    "name_english": "The Sundering",
    "name_transliteration": "Al-Inshiqaq",
    "revelation_type": "meccan",
    "beginner_intro": "Al-Inshiqaq (\"The Sundering\") is a Meccan surah of 25 ayahs. Arabic text: Tanzil Project (Uthmani script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 589,
            "arabic_text": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "When the heaven is split asunder"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And attentive to her Lord in fear,"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when the earth is spread out"
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And hath cast out all that was in her, and is empty"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And attentive to her Lord in fear!"
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 589,
            "arabic_text": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Thou, verily, O man, art working toward thy Lord a work which thou wilt meet (in His presence)."
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 30,
            "page": 589,
            "arabic_text": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then whoso is given his account in his right hand"
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 30,
            "page": 589,
            "arabic_text": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He truly will receive an easy reckoning"
                }
            ]
        },
        {
            "number_in_surah": 9,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And will return unto his folk in joy."
                }
            ]
        },
        {
            "number_in_surah": 10,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But whoso is given his account behind his back,"
                }
            ]
        },
        {
            "number_in_surah": 11,
            "juz": 30,
            "page": 589,
            "arabic_text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He surely will invoke destruction"
                }
            ]
        },
        {
            "number_in_surah": 12,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَيَصْلَىٰ سَعِيرًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And be thrown to scorching fire."
                }
            ]
        },
        {
            "number_in_surah": 13,
            "juz": 30,
            "page": 589,
            "arabic_text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He verily lived joyous with his folk,"
                }
            ]
        },
        {
            "number_in_surah": 14,
            "juz": 30,
            "page": 589,
            "arabic_text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He verily deemed that he would never return (unto Allah)."
                }
            ]
        },
        {
            "number_in_surah": 15,
            "juz": 30,
            "page": 589,
            "arabic_text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nay, but lo! his Lord is ever looking on him!"
                }
            ]
        },
        {
            "number_in_surah": 16,
            "juz": 30,
            "page": 589,
            "arabic_text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Oh, I swear by the afterglow of sunset,"
                }
            ]
        },
        {
            "number_in_surah": 17,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَٱلَّيْلِ وَمَا وَسَقَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And by the night and all that it enshroudeth,"
                }
            ]
        },
        {
            "number_in_surah": 18,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And by the moon when she is at the full,"
                }
            ]
        },
        {
            "number_in_surah": 19,
            "juz": 30,
            "page": 589,
            "arabic_text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "That ye shall journey on from plane to plane."
                }
            ]
        },
        {
            "number_in_surah": 20,
            "juz": 30,
            "page": 589,
            "arabic_text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "What aileth them, then, that they believe not"
                }
            ]
        },
        {
            "number_in_surah": 21,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And, when the Qur'an is recited unto them, worship not (Allah)?"
                }
            ]
        },
        {
            "number_in_surah": 22,
            "juz": 30,
            "page": 589,
            "arabic_text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nay, but those who disbelieve will deny;"
                }
            ]
        },
        {
            "number_in_surah": 23,
            "juz": 30,
            "page": 589,
            "arabic_text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And Allah knoweth best what they are hiding."
                }
            ]
        },
        {
            "number_in_surah": 24,
            "juz": 30,
            "page": 589,
            "arabic_text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "So give them tidings of a painful doom,"
                }
            ]
        },
        {
            "number_in_surah": 25,
            "juz": 30,
            "page": 589,
            "arabic_text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Save those who believe and do good works, for theirs is a reward unfailing."
                }
            ]
        }
    ]
}
