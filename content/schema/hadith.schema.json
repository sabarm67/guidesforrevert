{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://newmuslimcompanion.app/schema/hadith.schema.json",
  "title": "Hadith Collection",
  "type": "object",
  "required": ["collection_slug", "collection_title", "hadiths"],
  "properties": {
    "collection_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "collection_title": { "type": "string" },
    "collection_description": { "type": "string" },
    "hadiths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number_in_collection", "english_text", "narrator", "authenticity_grade"],
        "properties": {
          "number_in_collection": { "type": "integer", "minimum": 1 },
          "arabic_text": { "type": "string" },
          "english_text": { "type": "string" },
          "narrator": { "type": "string" },
          "authenticity_grade": { "type": "string", "enum": ["sahih", "hasan", "daif"] },
          "reference_note": { "type": "string" },
          "context": { "type": "string" },
          "explanation": { "type": "string" },
          "practical_application": { "type": "string" }
        }
      }
    }
  }
}
