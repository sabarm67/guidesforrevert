{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://newmuslimcompanion.app/schema/lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "required": ["slug", "stage_slug", "order", "title", "summary", "estimated_minutes", "body"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "stage_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "order": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "estimated_minutes": { "type": "integer", "minimum": 1 },
    "need_to_know": { "type": "boolean", "default": true, "description": "true = essential practice, false = good-to-know/deeper study" },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["heading", "text", "quote", "image", "video", "reflection", "faq"] },
          "text": { "type": "string" },
          "arabic": { "type": "string" },
          "transliteration": { "type": "string" },
          "translation": { "type": "string" },
          "reference": { "type": "string" },
          "image_ref": { "type": "string", "description": "Asset path (bundled, e.g. assets/images/wudu/01-wash-hands.svg) or a CMS-uploaded storage path, for type: image." },
          "caption": { "type": "string", "description": "Optional caption shown under an image block." },
          "video_url": { "type": "string", "description": "External video URL, for type: video. Schema/CMS support only for now — not yet rendered by the Flutter app (see docs/architecture/system-architecture.md)." },
          "question": { "type": "string" },
          "answer": { "type": "string" }
        }
      }
    },
    "further_reading": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "reference": { "type": "string" }
        }
      }
    }
  }
}
