{
    "number": 113,
    "name_arabic": "الفلق",
    "name_english": "The Daybreak",
    "name_transliteration": "Al-Falaq",
    "revelation_type": "meccan",
    "beginner_intro": "Al-Falaq (\"The Daybreak\") is a Meccan surah of 5 ayahs. Arabic text: Al-Quran Hafazan System (Uthmani Hafs script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 604,
            "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Say: I seek refuge in the Lord of the Daybreak"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 604,
            "arabic_text": "مِن شَرِّ مَا خَلَقَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "From the evil of that which He created;"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 604,
            "arabic_text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "From the evil of the darkness when it is intense,"
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 604,
            "arabic_text": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And from the evil of malignant witchcraft,"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 604,
            "arabic_text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And from the evil of the envier when he envieth."
                }
            ]
        }
    ]
}
