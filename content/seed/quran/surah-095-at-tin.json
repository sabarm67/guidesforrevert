{
    "number": 95,
    "name_arabic": "التين",
    "name_english": "The Fig",
    "name_transliteration": "At-Tin",
    "revelation_type": "meccan",
    "beginner_intro": "At-Tin (\"The Fig\") is a Meccan surah of 8 ayahs. Arabic text: Al-Quran Hafazan System (Uthmani Hafs script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 597,
            "arabic_text": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "By the fig and the olive,"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 597,
            "arabic_text": "وَطُورِ سِينِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "By Mount Sinai,"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 597,
            "arabic_text": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And by this land made safe;"
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 597,
            "arabic_text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Surely We created man of the best stature"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 597,
            "arabic_text": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then we reduced him to the lowest of the low,"
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 597,
            "arabic_text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Save those who believe and do good works, and theirs is a reward unfailing."
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 30,
            "page": 597,
            "arabic_text": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "So who henceforth will give the lie to thee about the judgment?"
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 30,
            "page": 597,
            "arabic_text": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Is not Allah the most conclusive of all judges?"
                }
            ]
        }
    ]
}
