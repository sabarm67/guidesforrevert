    "revelation_type": "meccan",
    "beginner_intro": "Al-Masad (\"The Palm Fiber\") is a Meccan surah of 5 ayahs. Arabic text: Al-Quran Hafazan System (Uthmani Hafs script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 603,
            "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The power of Abu Lahab will perish, and he will perish."
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 603,
            "arabic_text": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "His wealth and gains will not exempt him."
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 603,
            "arabic_text": "سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He will be plunged in flaming Fire,"
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 603,
            "arabic_text": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And his wife, the wood-carrier,"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 603,
            "arabic_text": "فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Will have upon her neck a halter of palm-fibre."
                }
            ]
        }
    ]
}
