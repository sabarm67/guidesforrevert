{
    "number": 81,
    "name_arabic": "التكوير",
    "name_english": "The Overthrowing",
    "name_transliteration": "At-Takwir",
    "revelation_type": "meccan",
    "beginner_intro": "At-Takwir (\"The Overthrowing\") is a Meccan surah of 29 ayahs. Arabic text: Tanzil Project (Uthmani script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 586,
            "arabic_text": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "When the sun is overthrown,"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when the stars fall,"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when the hills are moved,"
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when the camels big with young are abandoned,"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when the wild beasts are herded together,"
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when the seas rise,"
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when souls are reunited,"
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when the girl-child that was buried alive is asked"
                }
            ]
        },
        {
            "number_in_surah": 9,
            "juz": 30,
            "page": 586,
            "arabic_text": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "For what sin she was slain,"
                }
            ]
        },
        {
            "number_in_surah": 10,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when the pages are laid open,"
                }
            ]
        },
        {
            "number_in_surah": 11,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when the sky is torn away,"
                }
            ]
        },
        {
            "number_in_surah": 12,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when hell is lighted,"
                }
            ]
        },
        {
            "number_in_surah": 13,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And when the Garden is brought nigh,"
                }
            ]
        },
        {
            "number_in_surah": 14,
            "juz": 30,
            "page": 586,
            "arabic_text": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "(Then) every soul will know what it hath made ready."
                }
            ]
        },
        {
            "number_in_surah": 15,
            "juz": 30,
            "page": 586,
            "arabic_text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Oh, but I call to witness the planets,"
                }
            ]
        },
        {
            "number_in_surah": 16,
            "juz": 30,
            "page": 586,
            "arabic_text": "ٱلْجَوَارِ ٱلْكُنَّسِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The stars which rise and set,"
                }
            ]
        },
        {
            "number_in_surah": 17,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And the close of night,"
                }
            ]
        },
        {
            "number_in_surah": 18,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And the breath of morning"
                }
            ]
        },
        {
            "number_in_surah": 19,
            "juz": 30,
            "page": 586,
            "arabic_text": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "That this is in truth the word of an honoured messenger,"
                }
            ]
        },
        {
            "number_in_surah": 20,
            "juz": 30,
            "page": 586,
            "arabic_text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Mighty, established in the presence of the Lord of the Throne,"
                }
            ]
        },
        {
            "number_in_surah": 21,
            "juz": 30,
            "page": 586,
            "arabic_text": "مُّطَاعٍ ثَمَّ أَمِينٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "(One) to be obeyed, and trustworthy;"
                }
            ]
        },
        {
            "number_in_surah": 22,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And your comrade is not mad."
                }
            ]
        },
        {
            "number_in_surah": 23,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Surely he beheld Him on the clear horizon."
                }
            ]
        },
        {
            "number_in_surah": 24,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And he is not avid of the Unseen."
                }
            ]
        },
        {
            "number_in_surah": 25,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nor is this the utterance of a devil worthy to be stoned."
                }
            ]
        },
        {
            "number_in_surah": 26,
            "juz": 30,
            "page": 586,
            "arabic_text": "فَأَيْنَ تَذْهَبُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Whither then go ye?"
                }
            ]
        },
        {
            "number_in_surah": 27,
            "juz": 30,
            "page": 586,
            "arabic_text": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "This is naught else than a reminder unto creation,"
                }
            ]
        },
        {
            "number_in_surah": 28,
            "juz": 30,
            "page": 586,
            "arabic_text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Unto whomsoever of you willeth to walk straight."
                }
            ]
        },
        {
            "number_in_surah": 29,
            "juz": 30,
            "page": 586,
            "arabic_text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And ye will not, unless (it be) that Allah willeth, the Lord of Creation."
                }
            ]
        }
    ]
}
