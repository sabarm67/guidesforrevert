{
    "number": 78,
    "name_arabic": "النبإ",
    "name_english": "The Tidings",
    "name_transliteration": "An-Naba",
    "revelation_type": "meccan",
    "beginner_intro": "An-Naba (\"The Tidings\") is a Meccan surah of 40 ayahs. Arabic text: Al-Quran Hafazan System (Uthmani Hafs script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 582,
            "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Whereof do they question one another?"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 582,
            "arabic_text": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "(It is) of the awful tidings,"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 582,
            "arabic_text": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Concerning which they are in disagreement."
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 582,
            "arabic_text": "كَلَّا سَيَعْلَمُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nay, but they will come to know!"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 582,
            "arabic_text": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nay, again, but they will come to know!"
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 582,
            "arabic_text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Have We not made the earth an expanse,"
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَٱلْجِبَالَ أَوْتَادًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And the high hills bulwarks?"
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And We have created you in pairs,"
                }
            ]
        },
        {
            "number_in_surah": 9,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And have appointed your sleep for repose,"
                }
            ]
        },
        {
            "number_in_surah": 10,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And have appointed the night as a cloak,"
                }
            ]
        },
        {
            "number_in_surah": 11,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And have appointed the day for livelihood."
                }
            ]
        },
        {
            "number_in_surah": 12,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And We have built above you seven strong (heavens),"
                }
            ]
        },
        {
            "number_in_surah": 13,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And have appointed a dazzling lamp,"
                }
            ]
        },
        {
            "number_in_surah": 14,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And have sent down from the rainy clouds abundant water,"
                }
            ]
        },
        {
            "number_in_surah": 15,
            "juz": 30,
            "page": 582,
            "arabic_text": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Thereby to produce grain and plant,"
                }
            ]
        },
        {
            "number_in_surah": 16,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَجَنَّٰتٍ أَلْفَافًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And gardens of thick foliage."
                }
            ]
        },
        {
            "number_in_surah": 17,
            "juz": 30,
            "page": 582,
            "arabic_text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! the Day of Decision is a fixed time,"
                }
            ]
        },
        {
            "number_in_surah": 18,
            "juz": 30,
            "page": 582,
            "arabic_text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "A day when the trumpet is blown and ye come in multitudes,"
                }
            ]
        },
        {
            "number_in_surah": 19,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And the heaven is opened and becometh as gates,"
                }
            ]
        },
        {
            "number_in_surah": 20,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And the hills are set in motion and become as a mirage."
                }
            ]
        },
        {
            "number_in_surah": 21,
            "juz": 30,
            "page": 582,
            "arabic_text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! hell lurketh in ambush,"
                }
            ]
        },
        {
            "number_in_surah": 22,
            "juz": 30,
            "page": 582,
            "arabic_text": "لِّلطَّٰغِينَ مَـَٔابًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "A home for the rebellious."
                }
            ]
        },
        {
            "number_in_surah": 23,
            "juz": 30,
            "page": 582,
            "arabic_text": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "They will abide therein for ages."
                }
            ]
        },
        {
            "number_in_surah": 24,
            "juz": 30,
            "page": 582,
            "arabic_text": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Therein taste they neither coolness nor (any) drink"
                }
            ]
        },
        {
            "number_in_surah": 25,
            "juz": 30,
            "page": 582,
            "arabic_text": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Save boiling water and a paralysing cold:"
                }
            ]
        },
        {
            "number_in_surah": 26,
            "juz": 30,
            "page": 582,
            "arabic_text": "جَزَآءًۭ وِفَاقًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Reward proportioned (to their evil deeds)."
                }
            ]
        },
        {
            "number_in_surah": 27,
            "juz": 30,
            "page": 582,
            "arabic_text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "For lo! they looked not for a reckoning;"
                }
            ]
        },
        {
            "number_in_surah": 28,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "They called Our revelations false with strong denial."
                }
            ]
        },
        {
            "number_in_surah": 29,
            "juz": 30,
            "page": 582,
            "arabic_text": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Everything have We recorded in a Book."
                }
            ]
        },
        {
            "number_in_surah": 30,
            "juz": 30,
            "page": 582,
            "arabic_text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "So taste (of that which ye have earned). No increase do We give you save of torment."
                }
            ]
        },
        {
            "number_in_surah": 31,
            "juz": 30,
            "page": 583,
            "arabic_text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! for the duteous is achievement -"
                }
            ]
        },
        {
            "number_in_surah": 32,
            "juz": 30,
            "page": 583,
            "arabic_text": "حَدَآئِقَ وَأَعْنَٰبًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Gardens enclosed and vineyards,"
                }
            ]
        },
        {
            "number_in_surah": 33,
            "juz": 30,
            "page": 583,
            "arabic_text": "وَكَوَاعِبَ أَتْرَابًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And voluptuous women of equal age;"
                }
            ]
        },
        {
            "number_in_surah": 34,
            "juz": 30,
            "page": 583,
            "arabic_text": "وَكَأْسًۭا دِهَاقًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And a full cup."
                }
            ]
        },
        {
            "number_in_surah": 35,
            "juz": 30,
            "page": 583,
            "arabic_text": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "There hear they never vain discourse, nor lying -"
                }
            ]
        },
        {
            "number_in_surah": 36,
            "juz": 30,
            "page": 583,
            "arabic_text": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Requital from thy Lord - a gift in payment -"
                }
            ]
        },
        {
            "number_in_surah": 37,
            "juz": 30,
            "page": 583,
            "arabic_text": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lord of the heavens and the earth, and (all) that is between them, the Beneficent; with Whom none can converse."
                }
            ]
        },
        {
            "number_in_surah": 38,
            "juz": 30,
            "page": 583,
            "arabic_text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "On the day when the angels and the Spirit stand arrayed, they speak not, saving him whom the Beneficent alloweth and who speaketh right."
                }
            ]
        },
        {
            "number_in_surah": 39,
            "juz": 30,
            "page": 583,
            "arabic_text": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "That is the True Day. So whoso will should seek recourse unto his Lord."
                }
            ]
        },
        {
            "number_in_surah": 40,
            "juz": 30,
            "page": 583,
            "arabic_text": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! We warn you of a doom at hand, a day whereon a man will look on that which his own hands have sent before, and the disbeliever will cry: \"Would that I were dust!\""
                }
            ]
        }
    ]
}
