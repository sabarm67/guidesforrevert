{
    "number": 53,
    "name_arabic": "النجم",
    "name_english": "The Star",
    "name_transliteration": "An-Najm",
    "revelation_type": "meccan",
    "beginner_intro": "An-Najm (\"The Star\") is a Meccan surah of 62 ayahs. Arabic text: Tanzil Project (Uthmani script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 27,
            "page": 526,
            "arabic_text": "وَٱلنَّجْمِ إِذَا هَوَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "By the Star when it setteth,"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 27,
            "page": 526,
            "arabic_text": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Your comrade erreth not, nor is deceived;"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 27,
            "page": 526,
            "arabic_text": "وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nor doth he speak of (his own) desire."
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 27,
            "page": 526,
            "arabic_text": "إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "It is naught save an inspiration that is inspired,"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 27,
            "page": 526,
            "arabic_text": "عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Which one of mighty powers hath taught him,"
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 27,
            "page": 526,
            "arabic_text": "ذُو مِرَّةٍ فَٱسْتَوَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "One vigorous; and he grew clear to view"
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 27,
            "page": 526,
            "arabic_text": "وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "When he was on the uppermost horizon."
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 27,
            "page": 526,
            "arabic_text": "ثُمَّ دَنَا فَتَدَلَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then he drew nigh and came down"
                }
            ]
        },
        {
            "number_in_surah": 9,
            "juz": 27,
            "page": 526,
            "arabic_text": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Till he was (distant) two bows' length or even nearer,"
                }
            ]
        },
        {
            "number_in_surah": 10,
            "juz": 27,
            "page": 526,
            "arabic_text": "فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And He revealed unto His slave that which He revealed."
                }
            ]
        },
        {
            "number_in_surah": 11,
            "juz": 27,
            "page": 526,
            "arabic_text": "مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The heart lied not (in seeing) what it saw."
                }
            ]
        },
        {
            "number_in_surah": 12,
            "juz": 27,
            "page": 526,
            "arabic_text": "أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Will ye then dispute with him concerning what he seeth?"
                }
            ]
        },
        {
            "number_in_surah": 13,
            "juz": 27,
            "page": 526,
            "arabic_text": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And verily he saw him yet another time"
                }
            ]
        },
        {
            "number_in_surah": 14,
            "juz": 27,
            "page": 526,
            "arabic_text": "عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "By the lote-tree of the utmost boundary,"
                }
            ]
        },
        {
            "number_in_surah": 15,
            "juz": 27,
            "page": 526,
            "arabic_text": "عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nigh unto which is the Garden of Abode."
                }
            ]
        },
        {
            "number_in_surah": 16,
            "juz": 27,
            "page": 526,
            "arabic_text": "إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "When that which shroudeth did enshroud the lote-tree,"
                }
            ]
        },
        {
            "number_in_surah": 17,
            "juz": 27,
            "page": 526,
            "arabic_text": "مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The eye turned not aside nor yet was overbold."
                }
            ]
        },
        {
            "number_in_surah": 18,
            "juz": 27,
            "page": 526,
            "arabic_text": "لَقَدْ رَأَىٰ مِنْ ءَايَـٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Verily he saw one of the greater revelations of his Lord."
                }
            ]
        },
        {
            "number_in_surah": 19,
            "juz": 27,
            "page": 526,
            "arabic_text": "أَفَرَءَيْتُمُ ٱللَّـٰتَ وَٱلْعُزَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Have ye thought upon Al-Lat and Al-'Uzza"
                }
            ]
        },
        {
            "number_in_surah": 20,
            "juz": 27,
            "page": 526,
            "arabic_text": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And Manat, the third, the other?"
                }
            ]
        },
        {
            "number_in_surah": 21,
            "juz": 27,
            "page": 526,
            "arabic_text": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Are yours the males and His the females?"
                }
            ]
        },
        {
            "number_in_surah": 22,
            "juz": 27,
            "page": 526,
            "arabic_text": "تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "That indeed were an unfair division!"
                }
            ]
        },
        {
            "number_in_surah": 23,
            "juz": 27,
            "page": 526,
            "arabic_text": "إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "They are but names which ye have named, ye and your fathers, for which Allah hath revealed no warrant. They follow but a guess and that which (they) themselves desire. And now the guidance from their Lord hath come unto them."
                }
            ]
        },
        {
            "number_in_surah": 24,
            "juz": 27,
            "page": 526,
            "arabic_text": "أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Or shall man have what he coveteth?"
                }
            ]
        },
        {
            "number_in_surah": 25,
            "juz": 27,
            "page": 526,
            "arabic_text": "فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But unto Allah belongeth the after (life), and the former."
                }
            ]
        },
        {
            "number_in_surah": 26,
            "juz": 27,
            "page": 526,
            "arabic_text": "۞ وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And how many angels are in the heavens whose intercession availeth naught save after Allah giveth leave to whom He chooseth and accepteth."
                }
            ]
        },
        {
            "number_in_surah": 27,
            "juz": 27,
            "page": 527,
            "arabic_text": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَـٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! it is those who disbelieve in the Hereafter who name the angels with the names of females."
                }
            ]
        },
        {
            "number_in_surah": 28,
            "juz": 27,
            "page": 527,
            "arabic_text": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And they have no knowledge thereof. They follow but a guess, and lo! a guess can never take the place of the truth."
                }
            ]
        },
        {
            "number_in_surah": 29,
            "juz": 27,
            "page": 527,
            "arabic_text": "فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Then withdraw (O Muhammad) from him who fleeth from Our remembrance and desireth but the life of the world."
                }
            ]
        },
        {
            "number_in_surah": 30,
            "juz": 27,
            "page": 527,
            "arabic_text": "ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Such is their sum of knowledge. Lo! thy Lord is Best Aware of him who strayeth, and He is Best Aware of him whom goeth right."
                }
            ]
        },
        {
            "number_in_surah": 31,
            "juz": 27,
            "page": 527,
            "arabic_text": "وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And unto Allah belongeth whatsoever is in the heavens and whatsoever is in the earth, that He may reward those who do evil with that which they have done, and reward those who do good with goodness."
                }
            ]
        },
        {
            "number_in_surah": 32,
            "juz": 27,
            "page": 527,
            "arabic_text": "ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَـٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Those who avoid enormities of sin and abominations, save the unwilled offences - (for them) lo! thy Lord is of vast mercy. He is Best Aware of you (from the time) when He created you from the earth, and when ye were hidden in the bellies of your mothers. Therefor ascribe not purity unto yourselves. He is Best Aware of him who wardeth off (evil)."
                }
            ]
        },
        {
            "number_in_surah": 33,
            "juz": 27,
            "page": 527,
            "arabic_text": "أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Didst thou (O Muhammad) observe him who turned away,"
                }
            ]
        },
        {
            "number_in_surah": 34,
            "juz": 27,
            "page": 527,
            "arabic_text": "وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And gave a little, then was grudging?"
                }
            ]
        },
        {
            "number_in_surah": 35,
            "juz": 27,
            "page": 527,
            "arabic_text": "أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Hath he knowledge of the Unseen so that he seeth?"
                }
            ]
        },
        {
            "number_in_surah": 36,
            "juz": 27,
            "page": 527,
            "arabic_text": "أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Or hath he not had news of what is in the books of Moses"
                }
            ]
        },
        {
            "number_in_surah": 37,
            "juz": 27,
            "page": 527,
            "arabic_text": "وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And Abraham who paid his debt:"
                }
            ]
        },
        {
            "number_in_surah": 38,
            "juz": 27,
            "page": 527,
            "arabic_text": "أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "That no laden one shall bear another's load,"
                }
            ]
        },
        {
            "number_in_surah": 39,
            "juz": 27,
            "page": 527,
            "arabic_text": "وَأَن لَّيْسَ لِلْإِنسَـٰنِ إِلَّا مَا سَعَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And that man hath only that for which he maketh effort,"
                }
            ]
        },
        {
            "number_in_surah": 40,
            "juz": 27,
            "page": 527,
            "arabic_text": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And that his effort will be seen."
                }
            ]
        },
        {
            "number_in_surah": 41,
            "juz": 27,
            "page": 527,
            "arabic_text": "ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And afterward he will be repaid for it with fullest payment;"
                }
            ]
        },
        {
            "number_in_surah": 42,
            "juz": 27,
            "page": 527,
            "arabic_text": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And that thy Lord, He is the goal;"
                }
            ]
        },
        {
            "number_in_surah": 43,
            "juz": 27,
            "page": 527,
            "arabic_text": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And that He it is who maketh laugh, and maketh weep,"
                }
            ]
        },
        {
            "number_in_surah": 44,
            "juz": 27,
            "page": 527,
            "arabic_text": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And that He it is Who giveth death and giveth life;"
                }
            ]
        },
        {
            "number_in_surah": 45,
            "juz": 27,
            "page": 528,
            "arabic_text": "وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And that He createth the two spouses, the male and the female,"
                }
            ]
        },
        {
            "number_in_surah": 46,
            "juz": 27,
            "page": 528,
            "arabic_text": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "From a drop (of seed) when it is poured forth;"
                }
            ]
        },
        {
            "number_in_surah": 47,
            "juz": 27,
            "page": 528,
            "arabic_text": "وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And that He hath ordained the second bringing forth;"
                }
            ]
        },
        {
            "number_in_surah": 48,
            "juz": 27,
            "page": 528,
            "arabic_text": "وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And that He it is Who enricheth and contenteth;"
                }
            ]
        },
        {
            "number_in_surah": 49,
            "juz": 27,
            "page": 528,
            "arabic_text": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And that He it is Who is the Lord of Sirius;"
                }
            ]
        },
        {
            "number_in_surah": 50,
            "juz": 27,
            "page": 528,
            "arabic_text": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And that He destroyed the former (tribe of) A'ad,"
                }
            ]
        },
        {
            "number_in_surah": 51,
            "juz": 27,
            "page": 528,
            "arabic_text": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And (the tribe of) Thamud He spared not;"
                }
            ]
        },
        {
            "number_in_surah": 52,
            "juz": 27,
            "page": 528,
            "arabic_text": "وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And the folk of Noah aforetime, Lo! they were more unjust and more rebellious;"
                }
            ]
        },
        {
            "number_in_surah": 53,
            "juz": 27,
            "page": 528,
            "arabic_text": "وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And Al-Mu'tafikah He destroyed"
                }
            ]
        },
        {
            "number_in_surah": 54,
            "juz": 27,
            "page": 528,
            "arabic_text": "فَغَشَّىٰهَا مَا غَشَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "So that there covered them that which did cover."
                }
            ]
        },
        {
            "number_in_surah": 55,
            "juz": 27,
            "page": 528,
            "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Concerning which then, of the bounties of thy Lord, canst thou dispute?"
                }
            ]
        },
        {
            "number_in_surah": 56,
            "juz": 27,
            "page": 528,
            "arabic_text": "هَـٰذَا نَذِيرٌ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "This is a warner of the warners of old."
                }
            ]
        },
        {
            "number_in_surah": 57,
            "juz": 27,
            "page": 528,
            "arabic_text": "أَزِفَتِ ٱلْـَٔازِفَةُ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The threatened Hour is nigh."
                }
            ]
        },
        {
            "number_in_surah": 58,
            "juz": 27,
            "page": 528,
            "arabic_text": "لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "None beside Allah can disclose it."
                }
            ]
        },
        {
            "number_in_surah": 59,
            "juz": 27,
            "page": 528,
            "arabic_text": "أَفَمِنْ هَـٰذَا ٱلْحَدِيثِ تَعْجَبُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Marvel ye then at this statement,"
                }
            ]
        },
        {
            "number_in_surah": 60,
            "juz": 27,
            "page": 528,
            "arabic_text": "وَتَضْحَكُونَ وَلَا تَبْكُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And laugh and not weep,"
                }
            ]
        },
        {
            "number_in_surah": 61,
            "juz": 27,
            "page": 528,
            "arabic_text": "وَأَنتُمْ سَـٰمِدُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "While ye amuse yourselves?"
                }
            ]
        },
        {
            "number_in_surah": 62,
            "juz": 27,
            "page": 528,
            "arabic_text": "فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Rather prostrate yourselves before Allah and serve Him."
                }
            ]
        }
    ]
