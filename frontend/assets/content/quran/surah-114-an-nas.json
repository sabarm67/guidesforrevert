    "beginner_intro": "An-Nas (\"Mankind\") is a Meccan surah of 6 ayahs. Arabic text: Al-Quran Hafazan System (Uthmani Hafs script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 604,
            "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Say: I seek refuge in the Lord of mankind,"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 604,
            "arabic_text": "مَلِكِ ٱلنَّاسِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The King of mankind,"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 604,
            "arabic_text": "إِلَٰهِ ٱلنَّاسِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "The God of mankind,"
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 604,
            "arabic_text": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "From the evil of the sneaking whisperer,"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 604,
            "arabic_text": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Who whispereth in the hearts of mankind,"
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 604,
            "arabic_text": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Of the jinn and of mankind."
                }
            ]
        }
    ]
