{
    "number": 92,
    "name_arabic": "الليل",
    "name_english": "The Night",
    "name_transliteration": "Al-Layl",
    "revelation_type": "meccan",
    "beginner_intro": "Al-Layl (\"The Night\") is a Meccan surah of 21 ayahs. Arabic text: Al-Quran Hafazan System (Uthmani Hafs script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 595,
            "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "By the night enshrouding"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 595,
            "arabic_text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And the day resplendent"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 595,
            "arabic_text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And Him Who hath created male and female,"
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 595,
            "arabic_text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! your effort is dispersed (toward divers ends)."
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 595,
            "arabic_text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "As for him who giveth and is dutiful (toward Allah)"
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 595,
            "arabic_text": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And believeth in goodness;"
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 30,
            "page": 595,
            "arabic_text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Surely We will ease his way unto the state of ease."
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 30,
            "page": 595,
            "arabic_text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "But as for him who hoardeth and deemeth himself independent,"
                }
            ]
        },
        {
            "number_in_surah": 9,
            "juz": 30,
            "page": 595,
            "arabic_text": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And disbelieveth in goodness;"
                }
            ]
        },
        {
            "number_in_surah": 10,
            "juz": 30,
            "page": 595,
            "arabic_text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Surely We will ease his way unto adversity."
                }
            ]
        },
        {
            "number_in_surah": 11,
            "juz": 30,
            "page": 595,
            "arabic_text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "His riches will not save him when he perisheth."
                }
            ]
        },
        {
            "number_in_surah": 12,
            "juz": 30,
            "page": 595,
            "arabic_text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! Ours it is (to give) the guidance"
                }
            ]
        },
        {
            "number_in_surah": 13,
            "juz": 30,
            "page": 595,
            "arabic_text": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And lo! unto Us belong the latter portion and the former."
                }
            ]
        },
        {
            "number_in_surah": 14,
            "juz": 30,
            "page": 595,
            "arabic_text": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Therefor have I warned you of the flaming Fire"
                }
            ]
        },
        {
            "number_in_surah": 15,
            "juz": 30,
            "page": 596,
            "arabic_text": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Which only the most wretched must endure,"
                }
            ]
        },
        {
            "number_in_surah": 16,
            "juz": 30,
            "page": 596,
            "arabic_text": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He who denieth and turneth away."
                }
            ]
        },
        {
            "number_in_surah": 17,
            "juz": 30,
            "page": 596,
            "arabic_text": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Far removed from it will be the righteous"
                }
            ]
        },
        {
            "number_in_surah": 18,
            "juz": 30,
            "page": 596,
            "arabic_text": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Who giveth his wealth that he may grow (in goodness)."
                }
            ]
        },
        {
            "number_in_surah": 19,
            "juz": 30,
            "page": 596,
            "arabic_text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And none hath with him any favour for reward,"
                }
            ]
        },
        {
            "number_in_surah": 20,
            "juz": 30,
            "page": 596,
            "arabic_text": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Except as seeking (to fulfil) the purpose of his Lord Most High."
                }
            ]
        },
        {
            "number_in_surah": 21,
            "juz": 30,
            "page": 596,
            "arabic_text": "وَلَسَوْفَ يَرْضَىٰ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "He verily will be content."
                }
            ]
        }
    ]
}
