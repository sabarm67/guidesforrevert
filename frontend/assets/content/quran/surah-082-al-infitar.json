{
    "number": 82,
    "name_arabic": "الإنفطار",
    "name_english": "The Cleaving",
    "name_transliteration": "Al-Infitar",
    "revelation_type": "meccan",
    "beginner_intro": "Al-Infitar (\"The Cleaving\") is a Meccan surah of 19 ayahs. Arabic text: Tanzil Project (Uthmani script). Translation: Pickthall (public domain).",
    "ayahs": [
        {
            "number_in_surah": 1,
            "juz": 30,
            "page": 587,
            "arabic_text": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "When the heaven is cleft asunder,"
                }
            ]
        },
        {
            "number_in_surah": 2,
            "juz": 30,
            "page": 587,
            "arabic_text": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "When the planets are dispersed,"
                }
            ]
        },
        {
            "number_in_surah": 3,
            "juz": 30,
            "page": 587,
            "arabic_text": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "When the seas are poured forth,"
                }
            ]
        },
        {
            "number_in_surah": 4,
            "juz": 30,
            "page": 587,
            "arabic_text": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And the sepulchres are overturned,"
                }
            ]
        },
        {
            "number_in_surah": 5,
            "juz": 30,
            "page": 587,
            "arabic_text": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "A soul will know what it hath sent before (it) and what left behind."
                }
            ]
        },
        {
            "number_in_surah": 6,
            "juz": 30,
            "page": 587,
            "arabic_text": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "O man! What hath made thee careless concerning thy Lord, the Bountiful,"
                }
            ]
        },
        {
            "number_in_surah": 7,
            "juz": 30,
            "page": 587,
            "arabic_text": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Who created thee, then fashioned, then proportioned thee?"
                }
            ]
        },
        {
            "number_in_surah": 8,
            "juz": 30,
            "page": 587,
            "arabic_text": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Into whatsoever form He will, He casteth thee."
                }
            ]
        },
        {
            "number_in_surah": 9,
            "juz": 30,
            "page": 587,
            "arabic_text": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Nay, but ye deny the Judgment."
                }
            ]
        },
        {
            "number_in_surah": 10,
            "juz": 30,
            "page": 587,
            "arabic_text": "وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! there are above you guardians,"
                }
            ]
        },
        {
            "number_in_surah": 11,
            "juz": 30,
            "page": 587,
            "arabic_text": "كِرَامًا كَـٰتِبِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Generous and recording,"
                }
            ]
        },
        {
            "number_in_surah": 12,
            "juz": 30,
            "page": 587,
            "arabic_text": "يَعْلَمُونَ مَا تَفْعَلُونَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Who know (all) that ye do."
                }
            ]
        },
        {
            "number_in_surah": 13,
            "juz": 30,
            "page": 587,
            "arabic_text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Lo! the righteous verily will be in delight."
                }
            ]
        },
        {
            "number_in_surah": 14,
            "juz": 30,
            "page": 587,
            "arabic_text": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And lo! the wicked verily will be in hell;"
                }
            ]
        },
        {
            "number_in_surah": 15,
            "juz": 30,
            "page": 587,
            "arabic_text": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "They will burn therein on the Day of Judgment,"
                }
            ]
        },
        {
            "number_in_surah": 16,
            "juz": 30,
            "page": 587,
            "arabic_text": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "And will not be absent thence."
                }
            ]
        },
        {
            "number_in_surah": 17,
            "juz": 30,
            "page": 587,
            "arabic_text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Ah, what will convey unto thee what the Day of Judgment is!"
                }
            ]
        },
        {
            "number_in_surah": 18,
            "juz": 30,
            "page": 587,
            "arabic_text": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "Again, what will convey unto thee what the Day of Judgment is!"
                }
            ]
        },
        {
            "number_in_surah": 19,
            "juz": 30,
            "page": 587,
            "arabic_text": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ",
            "translations": [
                {
                    "translator": "Pickthall",
                    "text": "A day on which no soul hath power at all for any (other) soul. The (absolute) command on that day is Allah's."
                }
            ]
        }
    ]
}
